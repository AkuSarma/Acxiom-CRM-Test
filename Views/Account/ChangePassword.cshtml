@model ChangePasswordVm
@{ ViewData["Title"] = "Change password"; }
<div class="col-md-4 mx-auto bg-white p-4 rounded shadow-sm">
 <h2>Change password</h2>
 <form method="post">
  <div asp-validation-summary="ModelOnly" class="text-danger"></div>
  @foreach (var f in new[] { "Current", "New", "Confirm" }) {
   <div class="mb-3">
    @Html.Label(f, null, new { @class = "form-label" })
    @Html.Editor(f, new { htmlAttributes = new { @class = "form-control" } })
    @Html.ValidationMessage(f, "", new { @class = "text-danger" })
   </div>
  }
  <button class="btn btn-primary">Change</button>
 </form>
</div>
