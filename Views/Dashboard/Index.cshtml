@model DashVm
@{ ViewData["Title"] = "Dashboard"; var t = DateTime.Today; string F(DateTime d) => d.ToString("yyyy-MM-dd"); }
<div class="d-flex justify-content-between align-items-center mb-3">
 <h2 class="mb-0">Dashboard</h2>
 <span class="badge bg-info text-dark">@Model.ScopeLabel</span>
</div>
<form method="get" class="mb-3 d-flex gap-2 flex-wrap">
 <a class="btn btn-sm btn-outline-primary" asp-route-from="@F(t)" asp-route-to="@F(t)">Today</a>
 <a class="btn btn-sm btn-outline-primary" asp-route-from="@F(t.AddDays(-(int)t.DayOfWeek))" asp-route-to="@F(t)">This Week</a>
 <a class="btn btn-sm btn-outline-primary" asp-route-from="@F(new DateTime(t.Year, t.Month, 1))" asp-route-to="@F(t)">This Month</a>
 <a class="btn btn-sm btn-outline-secondary" asp-action="Index">All time</a>
 <input type="date" name="from" class="form-control form-control-sm w-auto" />
 <input type="date" name="to" class="form-control form-control-sm w-auto" />
 <button class="btn btn-sm btn-primary">Custom range</button>
</form>
<div class="row g-3">
 @foreach (var c in Model.Cards) {
  <div class="col-6 col-md-3">
   <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">@c.Key</div><div class="fs-3 fw-bold">@c.Value</div></div></div>
  </div>
 }
</div>
<div class="row g-3 mt-2">
 <div class="col-md-4"><div class="card p-3 shadow-sm"><h6>Lead Status</h6><canvas id="c1"></canvas></div></div>
 <div class="col-md-4"><div class="card p-3 shadow-sm"><h6>Opportunity Pipeline</h6><canvas id="c2"></canvas></div></div>
 <div class="col-md-4"><div class="card p-3 shadow-sm"><h6>Monthly Sales (Won)</h6><canvas id="c3"></canvas></div></div>
</div>
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
 const col = ['#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6'];
 new Chart(c1, { type: 'doughnut', data: { labels: @Html.Raw(JsonSerializer.Serialize(Model.LeadStatus.Keys)), datasets: [{ data: @Html.Raw(JsonSerializer.Serialize(Model.LeadStatus.Values)), backgroundColor: col }] } });
 new Chart(c2, { type: 'bar', data: { labels: @Html.Raw(JsonSerializer.Serialize(Model.Stages.Keys)), datasets: [{ label: 'Opportunities', data: @Html.Raw(JsonSerializer.Serialize(Model.Stages.Values)), backgroundColor: col }] } });
 new Chart(c3, { type: 'line', data: { labels: @Html.Raw(JsonSerializer.Serialize(Model.Monthly.Keys)), datasets: [{ label: 'Sales', data: @Html.Raw(JsonSerializer.Serialize(Model.Monthly.Values)), borderColor: '#3b82f6' }] } });
</script>
}
