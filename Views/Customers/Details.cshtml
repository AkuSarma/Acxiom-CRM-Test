@model CustomerDetailsVm
@{
 ViewData["Title"] = "Customer History - " + Model.Customer.CustomerName;
 string Resolve(string id) => id != null && Model.UserNames.TryGetValue(id, out var n) ? n : "Unassigned";
}
<div class="d-flex justify-content-between align-items-center mb-3">
 <div>
  <h2 class="mb-0">@Model.Customer.CustomerName <span class="badge @(Model.Customer.Status == "Active" ? "bg-success" : "bg-secondary") fs-6">@Model.Customer.Status</span></h2>
  <div class="text-muted small">Code: @Model.Customer.CustomerCode | Owner: @Model.AssignedToName</div>
 </div>
 <div class="d-flex gap-2">
  <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@Model.Customer.Id">Edit Customer</a>
  <a class="btn btn-sm btn-outline-success" asp-controller="Opportunities" asp-action="Create">+ Opportunity</a>
  <a class="btn btn-sm btn-outline-info" asp-controller="FollowUps" asp-action="Create">+ Follow-Up</a>
  <a class="btn btn-sm btn-outline-dark" asp-controller="Activities" asp-action="Create">+ Activity</a>
  <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Back</a>
 </div>
</div>

<div class="card shadow-sm mb-4">
 <div class="card-header fw-bold">Customer Profile</div>
 <div class="card-body">
  <div class="row g-3">
   <div class="col-md-3"><strong>Email:</strong><br />@Model.Customer.Email</div>
   <div class="col-md-3"><strong>Phone:</strong><br />@Model.Customer.Phone</div>
   <div class="col-md-3"><strong>Company:</strong><br />@(Model.Customer.CompanyName ?? "-")</div>
   <div class="col-md-3"><strong>City / State:</strong><br />@(Model.Customer.City ?? "-") / @(Model.Customer.State ?? "-")</div>
   <div class="col-md-6"><strong>Address:</strong><br />@(Model.Customer.Address ?? "-")</div>
   <div class="col-md-3"><strong>Created By:</strong><br />@Model.CreatedByName (@Model.Customer.CreatedDate.ToString("yyyy-MM-dd"))</div>
   <div class="col-md-3"><strong>Last Modified:</strong><br />@(Model.Customer.ModifiedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
   @if (!string.IsNullOrWhiteSpace(Model.Customer.Notes)) {
    <div class="col-12"><strong>Notes:</strong><br /><div class="p-2 bg-light rounded border">@Model.Customer.Notes</div></div>
   }
  </div>
 </div>
</div>

<div class="row g-3 mb-4">
 <div class="col-md-12">
  <div class="card shadow-sm">
   <div class="card-header fw-bold d-flex justify-content-between">
    <span>Related Opportunities (@Model.Opportunities.Count)</span>
    <span class="text-muted small">Open Pipeline: @Model.Opportunities.Where(o => o.Stage != "Won" && o.Stage != "Lost").Sum(o => o.Amount).ToString("N0")</span>
   </div>
   <div class="table-responsive">
    <table class="table table-sm table-striped mb-0">
     <thead><tr><th>Name</th><th>Stage</th><th>Status</th><th>Amount</th><th>Prob %</th><th>Weighted</th><th>Expected Close</th><th>Owner</th></tr></thead>
     <tbody>
      @if (Model.Opportunities.Count == 0) { <tr><td colspan="8" class="text-muted text-center py-2">No opportunities linked.</td></tr> }
      @foreach (var o in Model.Opportunities) {
       <tr>
        <td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.Id">@o.OpportunityName</a></td>
        <td>@o.Stage</td><td>@o.Status</td><td>@o.Amount.ToString("N0")</td><td>@o.Probability%</td>
        <td>@((o.Amount * o.Probability / 100).ToString("N0"))</td><td>@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td><td>@Resolve(o.AssignedTo)</td>
       </tr>
      }
     </tbody>
    </table>
   </div>
  </div>
 </div>

 <div class="col-md-6">
  <div class="card shadow-sm h-100">
   <div class="card-header fw-bold">Related Follow-Ups (@Model.FollowUps.Count)</div>
   <div class="table-responsive">
    <table class="table table-sm table-striped mb-0">
     <thead><tr><th>Date</th><th>Subject</th><th>Type</th><th>Status</th><th>Owner</th></tr></thead>
     <tbody>
      @if (Model.FollowUps.Count == 0) { <tr><td colspan="5" class="text-muted text-center py-2">No follow-ups recorded.</td></tr> }
      @foreach (var f in Model.FollowUps) {
       bool overdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.Today;
       <tr>
        <td>@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
        <td><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.Id">@f.Subject</a></td>
        <td>@f.FollowUpType</td>
        <td>@f.Status @if (overdue) { <span class="badge bg-danger">Overdue</span> }</td>
        <td>@Resolve(f.AssignedTo)</td>
       </tr>
      }
     </tbody>
    </table>
   </div>
  </div>
 </div>

 <div class="col-md-6">
  <div class="card shadow-sm h-100">
   <div class="card-header fw-bold">Related Activities (@Model.Activities.Count)</div>
   <div class="table-responsive">
    <table class="table table-sm table-striped mb-0">
     <thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Status</th><th>Owner</th></tr></thead>
     <tbody>
      @if (Model.Activities.Count == 0) { <tr><td colspan="5" class="text-muted text-center py-2">No activities logged.</td></tr> }
      @foreach (var a in Model.Activities) {
       <tr>
        <td>@a.ActivityDate.ToString("yyyy-MM-dd")</td>
        <td>@a.ActivityType</td>
        <td><a asp-controller="Activities" asp-action="Details" asp-route-id="@a.Id">@a.Subject</a></td>
        <td>@a.Status</td>
        <td>@Resolve(a.AssignedTo)</td>
       </tr>
      }
     </tbody>
    </table>
   </div>
  </div>
 </div>
</div>

<div class="card shadow-sm">
 <div class="card-header fw-bold">Customer Audit History (@Model.AuditLogs.Count)</div>
 <div class="table-responsive">
  <table class="table table-sm small mb-0">
   <thead><tr><th>Timestamp (UTC)</th><th>User</th><th>Action</th><th>Details</th></tr></thead>
   <tbody>
    @if (Model.AuditLogs.Count == 0) { <tr><td colspan="4" class="text-muted text-center py-2">No audit history entries.</td></tr> }
    @foreach (var log in Model.AuditLogs) {
     <tr>
      <td>@log.CreatedDate.ToString("u")</td>
      <td>@Resolve(log.UserId)</td>
      <td><span class="badge bg-secondary">@log.Action</span></td>
      <td>@((log.NewValue ?? log.OldValue ?? "").Length > 100 ? (log.NewValue ?? log.OldValue)[..100] + "..." : (log.NewValue ?? log.OldValue))</td>
     </tr>
    }
   </tbody>
  </table>
 </div>
</div>
