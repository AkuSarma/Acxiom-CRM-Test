@model List<EntityBase>
@{
 ViewData["Title"] = ViewBag.Title;
 var cols = (string[])ViewBag.Columns;
 var acts = ((string Action, string Label)[])ViewBag.RowActions;
 var views = (string[])ViewBag.Views;
 var userNames = ViewBag.UserNames as Dictionary<string, string> ?? new();
 bool canDel = User.IsInRole("Admin") || User.IsInRole("Manager");
 bool canAssign = ViewBag.CanAssign == true;
 string ResolveUser(string id) => id != null && userNames.TryGetValue(id, out var n) ? n : "Unassigned";
}
<div class="d-flex justify-content-between align-items-center mb-3">
 <h2>@ViewBag.Title <span class="badge bg-secondary fs-6">@ViewBag.Total</span></h2>
 <a class="btn btn-primary" asp-action="Create">+ New</a>
</div>

<form method="get" class="card card-body mb-3">
 <div class="row g-2 align-items-end">
  <div class="col-md-3">
   <label class="form-label small text-muted mb-1">Keyword</label>
   <input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Search…" />
  </div>
  @if (ViewData["FilterCustomers"] is SelectList fCust) {
   <div class="col-md-2">
    <label class="form-label small text-muted mb-1">Customer</label>
    @Html.DropDownList("customerId", fCust, "All Customers", new { @class = "form-select form-select-sm" })
   </div>
  }
  @if (ViewData["FilterLeads"] is SelectList fLead) {
   <div class="col-md-2">
    <label class="form-label small text-muted mb-1">Lead</label>
    @Html.DropDownList("leadId", fLead, "All Leads", new { @class = "form-select form-select-sm" })
   </div>
  }
  @if (ViewData["FilterActivityTypes"] is SelectList fActType) {
   <div class="col-md-2">
    <label class="form-label small text-muted mb-1">Activity Type</label>
    @Html.DropDownList("activityType", fActType, "All Types", new { @class = "form-select form-select-sm" })
   </div>
  }
  @if (ViewData["FilterStages"] is SelectList fStage) {
   <div class="col-md-2">
    <label class="form-label small text-muted mb-1">Stage</label>
    @Html.DropDownList("stage", fStage, "All Stages", new { @class = "form-select form-select-sm" })
   </div>
  }
  @if (ViewData["FilterStatuses"] is SelectList fStat) {
   <div class="col-md-2">
    <label class="form-label small text-muted mb-1">Status</label>
    @Html.DropDownList("status", fStat, "All Statuses", new { @class = "form-select form-select-sm" })
   </div>
  }
  @if (ViewData["FilterPriorities"] is SelectList fPrio) {
   <div class="col-md-2">
    <label class="form-label small text-muted mb-1">Priority</label>
    @Html.DropDownList("priority", fPrio, "All Priorities", new { @class = "form-select form-select-sm" })
   </div>
  }
  @if (ViewContext.RouteData.Values["controller"]?.ToString() is "FollowUps" or "Activities") {
   <div class="col-md-2">
    <label class="form-label small text-muted mb-1">Date</label>
    <input type="date" name="date" value="@Context.Request.Query["date"]" class="form-control form-control-sm" />
   </div>
  }
  @if (canAssign && ViewData["FilterUsers"] is SelectList fUsers) {
   <div class="col-md-2">
    <label class="form-label small text-muted mb-1">Assigned To</label>
    @Html.DropDownList("assignedTo", fUsers, "All Users", new { @class = "form-select form-select-sm" })
   </div>
  }
  <div class="col-auto">
   <button class="btn btn-sm btn-primary">Filter</button>
   <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Reset</a>
  </div>
 </div>
 @if (views != null) {
  <div class="mt-2 pt-2 border-top d-flex gap-1">
   <a class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.View as string) ? "btn-dark" : "btn-outline-secondary")" asp-action="Index">All</a>
   @foreach (var v in views) {
    <a class="btn btn-sm @(ViewBag.View as string == v ? "btn-dark" : "btn-outline-secondary")" asp-action="Index" asp-route-view="@v">@v</a>
   }
  </div>
 }
</form>

<div class="table-responsive">
 <table class="table table-striped table-hover bg-white shadow-sm">
  <thead class="table-dark">
   <tr>
    @foreach (var c in cols) { <th>@(c == "AssignedTo" ? "Assigned To" : c)</th> }
    <th>Actions</th>
   </tr>
  </thead>
  <tbody>
   @if (Model.Count == 0) {
    <tr><td colspan="@(cols.Length + 1)" class="text-center text-muted py-4">No records found.</td></tr>
   }
   @foreach (var item in Model) {
    <tr>
     @foreach (var c in cols) {
      var v = item.GetType().GetProperty(c)?.GetValue(item);
      if (c == "AssignedTo") { <td>@ResolveUser(v?.ToString())</td> }
      else if (v is DateTime d) { <td>@d.ToString("yyyy-MM-dd")</td> }
      else { <td>@v?.ToString()</td> }
     }
     <td class="text-nowrap">
      <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.Id">Details</a>
      <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
      @foreach (var a in acts) {
       <form method="post" asp-action="@a.Action" asp-route-id="@item.Id" class="d-inline">
        <button class="btn btn-sm btn-outline-success">@a.Label</button>
       </form>
      }
      @if (canDel) {
       <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Are you sure?')">
        <button class="btn btn-sm btn-outline-danger">Delete</button>
       </form>
      }
     </td>
    </tr>
   }
  </tbody>
 </table>
</div>

@{
 var queryDict = Context.Request.Query.ToDictionary(k => k.Key, k => k.Value.ToString());
 string PageUrl(int p) {
  var d = new Dictionary<string, string>(queryDict) { ["page"] = p.ToString() };
  return "?" + string.Join("&", d.Select(kv => Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(kv.Value)));
 }
}
<nav class="d-flex justify-content-between align-items-center">
 <span class="text-muted small">Page @ViewBag.Page of @(Math.Max(1, (int)ViewBag.Pages))</span>
 <div class="btn-group">
  @if (ViewBag.Page > 1) { <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(ViewBag.Page - 1)">Prev</a> }
  @if (ViewBag.Page < ViewBag.Pages) { <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(ViewBag.Page + 1)">Next</a> }
 </div>
</nav>
