@model object
@{
    var props = (string[])ViewBag.Props;
    ViewData["Title"] = ViewBag.Title;
}
<h2>@ViewBag.Title – @(ViewBag.IsEdit == true ? "Edit" : "Create")</h2>
<form method="post" class="card card-body shadow-sm">
    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-2" })
    <div class="row">
        @foreach (var p in props)
        {
            var isNotes = p is "Notes" or "Remarks" or "Description";
            <div class="@(isNotes ? "col-md-12" : "col-md-4") mb-3">
                @Html.Label(p, null, new { @class = "form-label fw-semibold" })
                @if (ViewData[p + "List"] is SelectList sl)
                {
                    @Html.DropDownList(p, sl, "-- select --", new { @class = "form-select" })
                }
                else if (isNotes)
                {
                    @Html.TextArea(p, null, 3, 40, new { @class = "form-control" })
                }
                else
                {
                    @Html.Editor(p, new { htmlAttributes = new { @class = "form-control" } })
                }
                @Html.ValidationMessage(p, "", new { @class = "text-danger small" })
            </div>
        }
    </div>
    <div class="mt-2">
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
